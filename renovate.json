{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "pep621",
    "github-actions",
    "dockerfile",
    "docker-compose",
    "custom.regex"
  ],
  "timezone": "Europe/Zurich",
  "schedule": [
    "* 0-3 * * 1"
  ],
  "prConcurrentLimit": 3,
  "branchConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "automerge": false,
  "platformAutomerge": false,
  "dependencyDashboard": {
    "enabled": true
  },
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "ignoreDeps": [
    "ghcr.io/flowcool/booksys-worker",
    "ghcr.io/flowcool/booksys-library",
    "ghcr.io/flowcool/booksys-byparr"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "pep621"
      ],
      "rangeStrategy": "pin"
    },
    {
      "matchManagers": [
        "github-actions",
        "dockerfile",
        "docker-compose"
      ],
      "pinDigests": true
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "matchPackageNames": [
        "python"
      ],
      "allowedVersions": "/^3\\.14(?:\\.|-|$)/"
    },
    {
      "matchManagers": [
        "pep621"
      ],
      "matchDepTypes": [
        "requires-python"
      ],
      "enabled": false
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Dockerfile(?:\\.library)?$/"
      ],
      "matchStrings": [
        "(?<depName>beautifulsoup4|PyYAML|uv)==(?<currentValue>[0-9.]+)"
      ],
      "datasourceTemplate": "pypi",
      "versioningTemplate": "pep440"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "vulnerabilityAlerts": {
    "enabled": false
  },
  "osvVulnerabilityAlerts": false
}
